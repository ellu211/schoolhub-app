{
  "name": "SchoolHub — School Management System",
  "short_name": "SchoolHub",
  "id": "com.schoolhub.app",
  "start_url": "./index.html",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "portrait",
  "background_color": "#f4f8fb",
  "theme_color": "#124e7f",
  "description": "Unified school management system for students, parents, teachers, and school administrators. Track attendance, fees, homework, timetable, and examination admit cards.",
  "categories": ["education", "productivity"],
  "icons": [
    {
      "src": "./assets/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./assets/icons/icon-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "./assets/icons/icon-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Timetable",
      "short_name": "Schedule",
      "description": "View daily class periods and schedule",
      "url": "./index.html#timetable",
      "icons": [{ "src": "./assets/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Attendance",
      "short_name": "Attendance",
      "description": "Check monthly attendance register",
      "url": "./index.html#attendance",
      "icons": [{ "src": "./assets/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Fee Management",
      "short_name": "Fees",
      "description": "Pay term fees and download receipts",
      "url": "./index.html#fees",
      "icons": [{ "src": "./assets/icons/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "screenshots": [
    {
      "src": "./assets/graphics/feature-graphic.svg",
      "sizes": "1024x500",
      "type": "image/svg+xml",
      "form_factor": "wide",
      "label": "SchoolHub Multi-Role Portal"
    }
  ]
}
